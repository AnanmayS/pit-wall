# ClickHouse (docker compose defaults)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=pitwall
CLICKHOUSE_PASSWORD=pitwall
CLICKHOUSE_DATABASE=pitwall

# DynamoDB Local (docker compose) — any dummy creds work locally
DYNAMODB_ENDPOINT_URL=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
PITWALL_DDB_TABLE=pitwall

# FastF1 on-disk cache (gets large: ~1-2 GB per season with telemetry)
FASTF1_CACHE_DIR=./data/fastf1-cache

# Claude API (milestone 2)
ANTHROPIC_API_KEY=
